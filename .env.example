# ==============================================================================
# ByteVoice Bangladesh — Environment Configuration
# Copy this file to `.env` and fill in your ElevenLabs credentials.
# ==============================================================================

# ElevenLabs Conversational AI Credentials (Required for live voice WebRTC)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Agent ID generated by running: python scripts/setup_bytevoice_agent.py
ELEVENLABS_AGENT_ID=

# Database Connection (Optional)
# If left empty, ByteVoice automatically defaults to local SQLite at data/bytevoice.db
# For PostgreSQL (Docker / Production / Supabase / Neon):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bytevoice
DATABASE_URL=

# Port for FastAPI backend (default: 8000)
PORT=8000
